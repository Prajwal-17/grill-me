# Browser API prefix; proxied by Vite locally and Nginx in Docker.
VITE_API_URL=/api
# Leave VITE_APP_ENV unset so vite dev/build select development/production.
# Set this only when intentionally overriding the Vite mode.
# VITE_APP_ENV=development
# Server-only target for vite dev/preview (never bundled into the browser).
# API_PROXY_TARGET=http://127.0.0.1:8027
