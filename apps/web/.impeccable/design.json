  "narrative": {
    "northStar": "Personal development workspace",
    "overview": "Grill Me is a personal developer practice workspace. Its visual system takes high-level inspiration from T3Code's consistent geometry, tonal surfaces, compact navigation, and settings organization. It adapts those principles to challenge creation, implementation review, quizzes, and revisiting practice.\n\nThe workspace preserves the original Grill Me palette from Git: neutral charcoal and white, inverted monochrome action buttons, the full-color mark, and the orange Grill accent. Earlier blue-tinted and navy/cobalt replacements were rejected. Keep the original hue identity. Improve depth through distinct canvas, content, table-header, hover, and overlay lightness; improve control clarity through border and focus contrast. Do not interpret \u201cmore color\u201d or the T3Code reference as permission to recolor the application.",
    "keyCharacteristics": [
      "Continuous application frame with compact navigation and task toolbars.",
      "Shared shadcn/Radix controls and semantic light/dark tokens.",
      "Searchable collections, aligned metadata, and sectioned settings.",
      "Restrained motion; no page entrance choreography."
    ],
    "dos": [
      "Do use shared semantic tokens and shadcn primitives for new controls.",
      "Do keep filters next to their collection and metadata aligned across rows.",
      "Do preserve product behavior, local profile scoping, storage keys, and URLs.",
      "Do test populated, empty, error, loading, keyboard, mobile, and both theme states."
    ],
    "donts": [
      "Don't turn the personal workspace into a team dashboard or marketing page.",
      "Don't add decoration, oversized headings, nested cards, or redundant instructions.",
      "Don't use monospace to make ordinary labels look technical.",
      "Don't infer completion from a review score or change quiz autosave semantics."
    ]
  }
}
