      "name": "Settings Group",
      "kind": "card",
      "description": "Flat bordered group with 8px corners and compact field rows; no ambient shadow.",
      "html": "<section class=\"ds-settings-group\" aria-labelledby=\"ds-settings-title\"><h3 class=\"ds-settings-title\" id=\"ds-settings-title\">Review limits</h3><div class=\"ds-settings-surface\"><div class=\"ds-settings-row\"><label class=\"ds-settings-label\" for=\"ds-settings-input\">Review timeout (seconds)<span class=\"ds-settings-description\">Maximum time allowed for a review.</span></label><input class=\"ds-settings-input\" id=\"ds-settings-input\" type=\"number\" value=\"900\" /></div></div></section>",
      "css": ".ds-settings-group{font-family:var(--font-interface,\"Inter Variable\",system-ui,sans-serif);color:var(--foreground,#202020);width:800px;max-width:100%;container-type:inline-size;}.ds-settings-title{margin:0 0 10px;font-size:14px;font-weight:600;line-height:1.5;}.ds-settings-surface{overflow:hidden;border:1px solid var(--line,#e2e2e2);border-radius:8px;background:var(--surface,#ffffff);}.ds-settings-row{display:flex;flex-direction:column;gap:12px;padding:14px 16px;}.ds-settings-label{font-size:14px;font-weight:500;line-height:1.5;}.ds-settings-description{display:block;margin-top:2px;color:var(--muted,#666666);font-size:13px;font-weight:400;line-height:1.5385;}.ds-settings-input{font-family:var(--font-interface,\"Inter Variable\",system-ui,sans-serif);height:32px;width:100%;min-width:0;padding:4px 12px;border:1px solid var(--control-border,#d4d4d4);border-radius:6px;background:var(--surface,#ffffff);color:var(--foreground,#202020);font-size:14px;line-height:1.5;outline:none;transition:border-color 150ms,box-shadow 150ms;}.ds-settings-input:hover{border-color:var(--control-border-hover,#aaaaaa);}.ds-settings-input:focus-visible{border-color:var(--focus,#202020);box-shadow:0 0 0 2px color-mix(in srgb,var(--focus,#202020) 20%,transparent);}@media(max-width:767px){.ds-settings-input{height:44px;font-size:max(1rem,16px);}}@media(prefers-reduced-motion:reduce){.ds-settings-input{transition:none;}}@container(min-width:600px){.ds-settings-row{flex-direction:row;align-items:center;justify-content:space-between;gap:24px;}.ds-settings-input{width:224px;}}:host-context([data-input=\"keyboard\"]) .ds-settings-input{transition:none;}"
