{
  "name": "@grill-me/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Grill Me Linux desktop application",
  "author": "Grill Me contributors <desktop@grill-me.local>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "package:deb": "bun run build:prod && electron-builder --linux deb --config electron-builder.yml --publish never",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts test *.ts --max-warnings 0",
    "test:keyring": "dbus-run-session -- bun run scripts/keyring-roundtrip.ts",
    "build:dev": "bun run scripts/build-backend.ts && electron-vite build --mode development",
    "build:prod": "bun run scripts/build-backend.ts && electron-vite build --mode production",
    "package:deb:dev": "bun run build:dev && electron-builder --linux deb --config electron-builder.dev.yml --publish never"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/node": "26.4.1",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "drizzle-orm": "^0.44.0",
    "@repo/backend": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "homepage": "https://github.com/Prajwal-17/grill-me"
}
