{
  "name": "@grill-me/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Grill Me desktop development edition",
  "author": "Grill Me contributors <desktop@grill-me.local>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build-backend.ts && electron-vite build",
    "package:deb": "bun run build && electron-builder --linux deb --publish never",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts test *.ts --max-warnings 0",
    "test:smoke": "bun run scripts/smoke.ts",
    "test:dev": "bun run scripts/smoke-dev.ts",
    "package:dir": "electron-builder --linux --dir --publish never"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/node": "26.4.1",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "@playwright/test": "^1.64.1",
    "drizzle-orm": "^0.44.0"
  },
  "homepage": "https://github.com/Prajwal-17/grill-me",
  "desktopName": "grill-me-dev.desktop"
}
