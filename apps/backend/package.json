{
  "name": "backend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development APP_ENV=development API_PORT=${API_PORT:-8027} WEB_ORIGIN=${WEB_ORIGIN:-http://localhost:8028,http://127.0.0.1:8028} bun run --hot src/index.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production APP_ENV=production API_PORT=${API_PORT:-17017} WEB_ORIGIN=${WEB_ORIGIN:-http://localhost:17018,http://127.0.0.1:17018} bun run src/index.ts",
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run db:migrate:dev",
    "db:migrate:dev": "NODE_ENV=development APP_ENV=development bun run src/shared/database/migrate.ts",
    "db:migrate:prod": "NODE_ENV=production APP_ENV=production bun run src/shared/database/migrate.ts",
    "codex:setup": "bun run scripts/codex-setup.ts",
    "codex:doctor": "bun run scripts/codex-doctor.ts",
    "db:studio": "bun run db:studio:dev",
    "db:studio:dev": "NODE_ENV=development APP_ENV=development drizzle-kit studio",
    "db:studio:prod": "NODE_ENV=production APP_ENV=production drizzle-kit studio"
  },
  "dependencies": {
    "@repo/preferences": "*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.0.0",
    "mammoth": "^1.13.0",
    "openai": "^5.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "10.9.1",
    "postgres": "^3.4.7",
    "typescript": "7.0.2"
  }
}
