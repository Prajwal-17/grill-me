{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/shared/database/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.0.0",
    "openai": "^5.0.0",
    "zod": "^4.0.0",
    "@repo/preferences": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
