{
  "name": "@repo/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && bun run scripts/generate-migration-manifest.ts",
    "db:check": "bun run scripts/generate-migration-manifest.ts --check",
    "studio": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "studio:dev": "GRILL_DESKTOP_CHANNEL=development drizzle-kit studio --config drizzle.sqlite.config.ts",
    "studio:prod": "GRILL_DESKTOP_CHANNEL=production drizzle-kit studio --config drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@napi-rs/keyring": "^2.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.0.0",
    "mammoth": "^1.13.0",
    "openai": "^5.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  }
}
