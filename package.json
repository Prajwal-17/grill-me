{
  "name": "grill-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run desktop:build",
    "test": "bun run test:desktop",
    "dev": "bun run desktop:dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check": "bun run format:check && bun run lint && bun run check-types",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "prompt:eval": "bun run --cwd apps/backend scripts/prompt-eval.ts",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build:prod",
    "desktop:deb": "bun run --cwd apps/desktop package:deb",
    "test:desktop": "bun run test:isolated",
    "desktop:build:dev": "bun run --cwd apps/desktop build:dev",
    "desktop:deb:dev": "bun run --cwd apps/desktop package:deb:dev"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.0",
    "@babel/preset-typescript": "8.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron"
  ]
}
