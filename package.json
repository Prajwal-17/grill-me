{
  "name": "grill-me",
  "version": "0.3.5",
  "private": true,
  "scripts": {
    "build": "bun run desktop:build",
    "test": "bun run test:desktop",
    "dev": "bun run desktop:dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check": "bun run format:check && bun run db:check && bun run lint && bun run check-types",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:check": "bun run --cwd packages/backend db:check",
    "db:studio:dev": "bun run --cwd packages/backend studio:dev",
    "db:studio:prod": "bun run --cwd packages/backend studio:prod",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build:prod",
    "desktop:deb": "bun run --cwd apps/desktop package:deb",
    "test:desktop": "bun run test:isolated",
    "web:build": "bun run --cwd apps/web build",
    "desktop:build:dev": "bun run --cwd apps/desktop build:dev",
    "desktop:deb:dev": "bun run --cwd apps/desktop package:deb:dev",
    "desktop:appimage:dev": "bun run --cwd apps/desktop package:appimage:dev",
    "desktop:dmg:arm64": "bun run --cwd apps/desktop package:dmg:arm64",
    "desktop:dmg:arm64:dev": "bun run --cwd apps/desktop package:dmg:arm64:dev",
    "desktop:dmg:x64": "bun run --cwd apps/desktop package:dmg:x64",
    "desktop:dmg:x64:dev": "bun run --cwd apps/desktop package:dmg:x64:dev"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.0",
    "@babel/preset-typescript": "8.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron"
  ]
}
