{
  "name": "grill-me",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "bun run test:desktop",
    "dev": "bun run desktop:dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check": "bun run format:check && bun run lint && bun run check-types",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:migrate:dev": "bun run --cwd apps/backend db:migrate:dev",
    "db:migrate:prod": "bun run --cwd apps/backend db:migrate:prod",
    "codex:setup": "bun run --cwd apps/backend codex:setup",
    "codex:doctor": "bun run --cwd apps/backend codex:doctor",
    "db:studio": "bun run --cwd apps/backend db:studio",
    "db:studio:dev": "bun run --cwd apps/backend db:studio:dev",
    "db:studio:prod": "bun run --cwd apps/backend db:studio:prod",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "prompt:eval": "bun run --cwd apps/backend scripts/prompt-eval.ts",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:deb": "bun run --cwd apps/desktop package:deb",
    "test:desktop": "bun run test:isolated --sqlite",
    "dev:web": "bun run scripts/dev-web.ts",
    "dev:backend": "bun run --cwd apps/backend dev:local",
    "dev:ui": "bun run --cwd apps/web dev:local",
    "dev:postgres": "turbo run dev --filter=web --filter=backend"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.0",
    "@babel/preset-typescript": "8.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron"
  ]
}
